# PnP Telegram AI Bridge — copy ke .env, git clone anywhere
# === WAJIB ===
TELEGRAM_BOT_TOKEN=isi_token_dari_BotFather_setelah_revoke
# === PnP MODEL — ganti ke model apa aja tanpa edit kode ===
# Format: provider/model (sesuai `opencode models`)
MODEL=opencode/muse-spark-1.2-contributor-free
# Alternatif PnP (tinggal uncomment):
# MODEL=groq/llama-3.3-70b-versatile
# MODEL=groq/openai/gpt-oss-120b
# MODEL=deepseek/deepseek-v4-flash
# MODEL=openai/gpt-4o-mini
# MODEL=openai/gpt-4o
# MODEL=opencode/big-pickle
# === PnP METODE — kosong = polling (dev, laptop nyala), isi = webhook (prod, gratis) ===
# WEBHOOK_URL=https://your-app.up.railway.app/webhook
# WEBHOOK_SECRET=random_32_char_untuk_X-Telegram-Bot-Api-Secret-Token
# === PnP SETUP — ganti WORK_DIR ke project kamu, atau biarkan /app ===
WORK_DIR=/app
# WORK_DIR=C:\Users\Reynboo\Project\MyApp  # Windows dev
ALLOWED_USER_IDS=1925430810
# PORT=8000
# TIMEOUT_SECONDS=300
# === STABILITAS & FEATURE FLAGS (matikan instant jika bikin bug, tanpa edit code) ===
ENABLE_AUTO_RESTART=1  # 0=matikan auto-restart mtime, pakai /restart manual
FEATURE_WORKDIR=1
FEATURE_SESSIONS=1
FEATURE_CLEANUP=1
FEATURE_VOICE=1
FEATURE_DOC=1
FEATURE_QUEUE=1
# Optimasi anti-mati 60s: capped 5s (override via env)
# MAX_BACKOFF=5
# Fallback model jika primary timeout
# FALLBACK_MODEL=groq/llama-3.3-70b-versatile
